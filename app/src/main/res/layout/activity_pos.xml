<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light_slate">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <!-- Header Section (Deep Navy Blue #0F172A) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/primary_navy"
                app:cardCornerRadius="0dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_terminal_header"
                            app:tint="#2DD4BF"
                            android:contentDescription="@string/pos_terminal_title" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pos_terminal_title"
                                android:textColor="#FFFFFF"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pos_terminal_subtitle"
                                android:textColor="#94A3B8"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Terminal Online Pill -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ic_check_circle"
                            android:backgroundTint="#059669"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="ONLINE"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp">

                <!-- 1. Transaction Input Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTransactionInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/stroke_slate"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_transaction_input"
                            android:textColor="@color/primary_navy"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="16dp"
                            android:text="Input manual atau pilih skenario pengujian di bawah"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- Barcode Field -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilBarcode"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/label_barcode"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="@color/secondary_teal"
                            app:hintTextColor="@color/secondary_teal"
                            app:startIconDrawable="@drawable/ic_barcode"
                            app:startIconTint="@color/secondary_teal">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etBarcode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapCharacters"
                                android:text="BRG-001"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Total Belanja Field -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilTotalAmount"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/label_total_amount"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="@color/secondary_teal"
                            app:hintTextColor="@color/secondary_teal"
                            app:prefixText="Rp "
                            app:prefixTextColor="@color/text_primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTotalAmount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:text="75000"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Payment Gateway Field -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilGateway"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/label_payment_method"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="@color/secondary_teal"
                            app:hintTextColor="@color/secondary_teal">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etGateway"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="QRIS Bank Central"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Button Process (Teal / Emerald #0D9488) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnProcessTransaction"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="18dp"
                            android:text="@string/btn_process_transaction"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/secondary_teal"
                            app:cornerRadius="12dp"
                            app:elevation="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Simulation & Testing Preset Scenarios -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPresets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/stroke_slate"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_quick_simulation"
                            android:textColor="@color/primary_navy"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="12dp"
                            android:text="Pemicu langsung seluruh skenario modul Pertemuan 12:"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimSuccess"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start|center_vertical"
                            android:text="@string/sim_normal_trx"
                            android:textColor="@color/status_success"
                            app:cornerRadius="10dp"
                            app:strokeColor="@color/status_success" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimBarcodeNotFound"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="start|center_vertical"
                            android:text="@string/sim_barcode_not_found"
                            android:textColor="@color/status_warning"
                            app:cornerRadius="10dp"
                            app:strokeColor="@color/status_warning" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimGatewayTimeout"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="start|center_vertical"
                            android:text="@string/sim_gateway_timeout"
                            android:textColor="@color/status_error"
                            app:cornerRadius="10dp"
                            app:strokeColor="@color/status_error" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimLimitExceeded"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="start|center_vertical"
                            android:text="@string/sim_limit_exceeded"
                            android:textColor="@color/primary_navy"
                            app:cornerRadius="10dp"
                            app:strokeColor="@color/primary_navy" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimFatalCrash"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="start|center_vertical"
                            android:text="@string/sim_fatal_crash"
                            android:textColor="#7F1D1D"
                            app:cornerRadius="10dp"
                            app:strokeColor="#7F1D1D" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Terminal Result Card (Corner radius 16dp, elevation 4dp, neat border) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/stroke_slate"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/card_status_title"
                                android:textColor="@color/primary_navy"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvRetryBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/ic_check_circle"
                                android:backgroundTint="@color/status_info"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:text="Retry: 0/3"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Progress Bar during loading state -->
                        <ProgressBar
                            android:id="@+id/progressBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/secondary_teal"
                            android:visibility="gone" />

                        <!-- Status Icon & Label -->
                        <LinearLayout
                            android:id="@+id/llStatusHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivStatusIcon"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/status_success"
                                android:contentDescription="Status Icon" />

                            <TextView
                                android:id="@+id/tvStatusTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/status_idle"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Detail Information Box -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardDetailsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            app:cardBackgroundColor="@color/bg_light_slate"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/stroke_slate"
                            app:strokeWidth="1dp">

                            <TextView
                                android:id="@+id/tvStatusDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:lineSpacingExtra="4dp"
                                android:padding="14dp"
                                android:text="Menunggu input transaksi kasir.\nSilakan tekan tombol 'Proses Transaksi' atau gunakan tombol pengujian skenario."
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Fallback / Supervisor Status Notice -->
                        <TextView
                            android:id="@+id/tvActionHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/status_info"
                            android:textSize="12sp"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
